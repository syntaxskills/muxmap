{
  "name": "muxmap",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntaxskills/muxmap.git"
  },
  "bugs": {
    "url": "https://github.com/syntaxskills/muxmap/issues"
  },
  "homepage": "https://github.com/syntaxskills/muxmap#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "sh -c 'node --experimental-strip-types server/index.ts & server_pid=$!; trap \"kill $server_pid\" EXIT INT TERM; vite'",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test src/*.test.ts server/*.test.ts",
    "hooks:install": "node --experimental-strip-types scripts/install-agent-hooks.ts",
    "start": "node --experimental-strip-types server/index.ts",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.1"
  }
}
